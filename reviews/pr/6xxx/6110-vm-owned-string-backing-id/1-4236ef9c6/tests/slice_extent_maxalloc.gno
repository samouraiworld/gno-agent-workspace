// MAXALLOC: 260000
// PKGPATH: gno.land/r/test
package test

import "runtime"

const chunk = ""

var kept string

func build() string {
	s := ""
	for i := 0; i < 10; i++ {
		s += chunk
	}
	return s
}

func main() {
	big := build() // 100000-byte backing
	kept = big[0:1]
	big = "" // source dies; only the 1-byte slice survives
	runtime.GC()
	b2 := build() // same work again
	println("ok", len(kept), len(b2), runtime.MemStats())
}

// Output:
// x
