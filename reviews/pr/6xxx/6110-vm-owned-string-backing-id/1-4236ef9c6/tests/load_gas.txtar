# Measures the fillTypesOfValue re-mint charge: one call that cold-loads
# 2000 stored strings of ~100 bytes each. master charges nothing for a
# loaded string; the branch charges allocGas(allocString+len) per load.

loadpkg gno.land/r/test/loadgas $WORK/loadgas

gnoland start -no-parallel

gnokey maketx call -pkgpath gno.land/r/test/loadgas -func Walk -gas-fee 10000000ugnot -gas-wanted 100_000_000 -simulate skip -chainid tendermint_test test1
stdout 'GAS USED:'

-- loadgas/gnomod.toml --
module = "gno.land/r/test/loadgas"
gno = "0.9"

-- loadgas/loadgas.gno --
package loadgas

import "strconv"

var items []string

const pad = "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"

func init() {
	for i := 0; i < 2000; i++ {
		items = append(items, pad+strconv.Itoa(i))
	}
}

func Walk(cur realm) int {
	n := 0
	for i := 0; i < len(items); i++ {
		n += len(items[i])
	}
	return n
}
