@@ -0,0 +1,27 @@
+package gnolang
+
+import (
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestMain(m *testing.M) {
+	code := m.Run()
+	var b strings.Builder
+	fmt.Fprintf(&b, "ZZ-REPORT calls=%d blocks=%d names=%d diffs=%d\n", ZZCalls, ZZBlocks, ZZNames, len(ZZDiffs))
+	seen := map[string]int{}
+	order := []string{}
+	for _, d := range ZZDiffs {
+		if seen[d] == 0 {
+			order = append(order, d)
+		}
+		seen[d]++
+	}
+	for _, d := range order {
+		fmt.Fprintf(&b, "ZZ-DIFF x%d %s\n", seen[d], d)
+	}
+	os.WriteFile("/tmp/zz6089.txt", []byte(b.String()), 0o644)
+	os.Exit(code)
+}
