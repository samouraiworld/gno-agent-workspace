diff --git a/gnovm/pkg/gnolang/preprocess.go b/gnovm/pkg/gnolang/preprocess.go
index 33bcbf81a..8018a9b26 100644
--- a/gnovm/pkg/gnolang/preprocess.go
+++ b/gnovm/pkg/gnolang/preprocess.go
@@ -724,6 +724,25 @@ func Preprocess(store Store, ctx BlockNode, n Node) Node {
 			return n, TRANS_CONTINUE
 		})
 
+	// ZZ differential sweep: every block reachable from n, plus the ctx chain.
+	Transcribe(n,
+		func(ns []Node, ftype TransField, index int, nn Node, stage TransStage) (Node, TransCtrl) {
+			if stage != TRANS_ENTER {
+				return nn, TRANS_CONTINUE
+			}
+			if bn, ok := nn.(BlockNode); ok {
+				if bn.IsInitialized() {
+					ZZSweepBlock(bn.GetStaticBlock())
+				}
+			}
+			return nn, TRANS_CONTINUE
+		})
+	for c := ctx; c != nil; {
+		sb := c.GetStaticBlock()
+		ZZSweepBlock(sb)
+		c = sb.GetParentNode(store)
+	}
+
 	return n
 }
 
diff --git a/gnovm/pkg/gnolang/zz_equiv_report_test.go b/gnovm/pkg/gnolang/zz_equiv_report_test.go
