+// PR 6089's replacement, verbatim.
+func (sb *StaticBlock) isAssignableNew(store Store, n Name) bool {
+	idx, ok := sb.GetLocalIndex(n)
+	bp := sb.GetParentNode(store)
+	for {
+		if ok {
+			return sb.NameSources[idx].Type != NSFuncDecl
+		} else if bp != nil {
+			idx, ok = bp.GetLocalIndex(n)
+			sb = bp.GetStaticBlock()
+			bp = bp.GetParentNode(store)
+		} else if _, ok := UverseNode().GetLocalIndex(n); ok {
+			return false
+		} else {
+			return true
+		}
+	}
+}
+
+// ZZSweepBlock compares the two predicates over every name in one block.
+func ZZSweepBlock(b *StaticBlock) {
+	atomic.AddInt64(&ZZBlocks, 1)
+	if len(b.NameSources) != len(b.Names) {
+		zzRecord("LENMISMATCH loc=%v names=%d nsrcs=%d", b.Location, len(b.Names), len(b.NameSources))
+		return
+	}
+	for i, nm := range b.Names {
+		atomic.AddInt64(&ZZNames, 1)
+		inList := slices.Contains(b.UnassignableNames, nm)
+		isFD := b.NameSources[i].Type == NSFuncDecl
+		if inList != isFD {
+			zzRecord("BLOCK loc=%v name=%s inUnassignable=%v NSFuncDecl=%v nsrcType=%d", b.Location, nm, inList, isFD, b.NameSources[i].Type)
+		}
+	}
+}
+
+// ZZEquivStats counts the differential sweep below.
+var (
+	ZZCalls  int64
+	ZZNames  int64
+	ZZBlocks int64
+	ZZDiffs  []string
+	ZZMu     sync.Mutex
+)
+
+func zzRecord(f string, a ...any) {
+	ZZMu.Lock()
+	ZZDiffs = append(ZZDiffs, fmt.Sprintf(f, a...))
+	ZZMu.Unlock()
+}
+
+func (sb *StaticBlock) IsAssignable(store Store, n Name) bool {
+	got := sb.isAssignableOld(store, n)
+	alt := sb.isAssignableNew(store, n)
+	atomic.AddInt64(&ZZCalls, 1)
+	if got != alt {
+		zzRecord("CALLSITE name=%s loc=%v old=%v new=%v", n, sb.Location, got, alt)
+	}
+	// Sweep every name declared in every block on the chain, not only n.
+	b := sb
+	for {
+		atomic.AddInt64(&ZZBlocks, 1)
+		if len(b.NameSources) != len(b.Names) {
+			zzRecord("LENMISMATCH loc=%v names=%d nsrcs=%d", b.Location, len(b.Names), len(b.NameSources))
+		} else {
+			for i, nm := range b.Names {
+				atomic.AddInt64(&ZZNames, 1)
+				inList := slices.Contains(b.UnassignableNames, nm)
+				isFD := b.NameSources[i].Type == NSFuncDecl
+				if inList != isFD {
+					ZZDiffs = append(ZZDiffs, fmt.Sprintf("BLOCK loc=%v name=%s inUnassignable=%v NSFuncDecl=%v", b.Location, nm, inList, isFD))
+				}
+			}
+		}
+		bp2 := b.GetParentNode(store)
+		if bp2 == nil {
+			break
+		}
+		b = bp2.GetStaticBlock()
+	}
+	return got
+}
