# b1-refactor-bech32-once.patch
#
# GetUserView decodes the bech32 address to set isAddress, then throws the
# answer away and CreateUsernameFromBech32 decodes the same string again for
# the display form. The exported helper exists only so a unit test could reach
# the branch; this PR's own TestHTTPHandler_GetUserView_Address already asserts
# "g1ma...dlf5" through the handler, so the branch stays covered.
#
# Repro from a plain clone (go1.25.9):
#
#   git clone https://github.com/gnolang/gno
#   cd gno
#   git fetch origin 876762bdf2ea6635b27e2b0a42f26f9fdc54af24
#   git checkout 876762bdf2ea6635b27e2b0a42f26f9fdc54af24
#   git apply /path/to/b1-refactor-bech32-once.patch
#   gofmt -l gno.land/pkg/gnoweb/            # no output
#   go test ./gno.land/pkg/gnoweb/           # ok  ...gnoweb  6.242s
#
# Measured at head 876762bdf: +4/-45 (handler_http.go +4/-10, the deleted
# TestHTTPHandler_CreateUsernameFromBech32 -35), one decode per page instead
# of two, package green.
diff --git a/gno.land/pkg/gnoweb/handler_http.go b/gno.land/pkg/gnoweb/handler_http.go
index 4cd7a0540..651f9e4f8 100644
--- a/gno.land/pkg/gnoweb/handler_http.go
+++ b/gno.land/pkg/gnoweb/handler_http.go
@@ -576,15 +576,6 @@ func (h *HTTPHandler) userExists(ctx context.Context, username string) (bool, er
 	}
 }
 
-// CreateUsernameFromBech32 creates a shortened version of the username if it's a valid bech32 address.
-func CreateUsernameFromBech32(username string) string {
-	if _, err := crypto.AddressFromBech32(username); err != nil {
-		return username
-	}
-
-	return username[:4] + "..." + username[len(username)-4:]
-}
-
 // displayPackageName returns versioned name for a package path.
 // Examples: "gno.land/r/demo/foo/v2" → "foo/v2", "gno.land/r/demo/foo" → "foo".
 func displayPackageName(pkgPath string) string {
@@ -646,7 +637,10 @@ func (h *HTTPHandler) GetUserView(ctx context.Context, gnourl *weburl.GnoURL) (i
 	pkgCount := len(contribs)
 	pureCount := pkgCount - realmCount
 
-	username = CreateUsernameFromBech32(username)
+	if isAddress {
+		// An address is displayed shortened: g1ab...wxyz.
+		username = username[:4] + "..." + username[len(username)-4:]
+	}
 
 	// TODO: get from user r/profile and use placeholder if not set
 	handlename := "Gnome " + username
