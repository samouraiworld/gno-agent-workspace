# measure what the docs quickstart deploy actually costs

gnoland start

# quickstart step 7: no -max-deposit, docs' gas flags
gnokey maketx addpkg -pkgdir $WORK/counter -pkgpath gno.land/r/test1/counter -gas-fee 20000ugnot -gas-wanted 20000000 -chainid=tendermint_test test1
stdout OK!

# quickstart step 8
gnokey maketx call -pkgpath gno.land/r/test1/counter -func Increment -gas-fee 2000ugnot -gas-wanted 2000000 -chainid=tendermint_test test1
stdout OK!

gnokey query vm/qstorage --data gno.land/r/test1/counter

-- counter/gnomod.toml --
module = "gno.land/r/test1/counter"
gno = "0.9"

-- counter/counter.gno --
package counter

import "strconv"

var counter int

func Increment(_ realm) int {
	counter++
	return counter
}

func Render(_ string) string {
	return strconv.Itoa(counter)
}

-- counter/counter_test.gno --
package counter

import "testing"

func TestIncrement(cur realm, t *testing.T) {
	counter = 0
	val := Increment(cross(cur))
	if val != 1 {
		t.Fatalf("result from Increment(): %d != 1", val)
	}
	if counter != val {
		t.Fatalf("counter (%d) != val (%d)", counter, val)
	}
}
